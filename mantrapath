#!/bin/bash

# MantraPath - Unified Project Manager
# A single command to manage your entire MantraPath development environment
# 
# Usage:
#   ./mantrapath start     - Start full development environment
#   ./mantrapath backend   - Start backend services only  
#   ./mantrapath frontend  - Start frontend only
#   ./mantrapath stop      - Stop all services
#   ./mantrapath setup     - Initial project setup
#   ./mantrapath status    - Check service status
#   ./mantrapath logs      - View service logs
#   ./mantrapath clean     - Clean up containers and volumes

set -e

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Project banner
show_banner() {
    echo -e "${BLUE}"
    echo "  ███╗   ███╗ █████╗ ███╗   ██╗████████╗██████╗  █████╗ ██████╗  █████╗ ████████╗██╗  ██╗"
    echo "  ████╗ ████║██╔══██╗████╗  ██║╚══██╔══╝██╔══██╗██╔══██╗██╔══██╗██╔══██╗╚══██╔══╝██║  ██║"
    echo "  ██╔████╔██║███████║██╔██╗ ██║   ██║   ██████╔╝███████║██████╔╝███████║   ██║   ███████║"
    echo "  ██║╚██╔╝██║██╔══██║██║╚██╗██║   ██║   ██╔══██╗██╔══██║██╔═══╝ ██╔══██║   ██║   ██╔══██║"
    echo "  ██║ ╚═╝ ██║██║  ██║██║ ╚████║   ██║   ██║  ██║██║  ██║██║     ██║  ██║   ██║   ██║  ██║"
    echo "  ╚═╝     ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝   ╚═╝   ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝     ╚═╝  ╚═╝   ╚═╝   ╚═╝  ╚═╝"
    echo -e "${NC}"
    echo -e "${GREEN}    Holistic Mental Wellness Platform - Development Manager${NC}"
    echo -e "${YELLOW}    Version 2.0 | August 2025${NC}"
    echo ""
}

# Check prerequisites
check_prerequisites() {
    echo -e "${BLUE}🔍 Checking prerequisites...${NC}"
    
    # Check Docker
    if ! command -v docker >/dev/null 2>&1; then
        echo -e "${RED}❌ Docker not found. Please install Docker first.${NC}"
        exit 1
    fi
    
    if ! docker info >/dev/null 2>&1; then
        echo -e "${RED}❌ Docker is not running. Please start Docker first.${NC}"
        exit 1
    fi
    
    # Check Node.js
    if ! command -v node >/dev/null 2>&1; then
        echo -e "${RED}❌ Node.js not found. Please install Node.js first.${NC}"
        exit 1
    fi
    
    echo -e "${GREEN}✅ All prerequisites met${NC}"
}

# Start backend services
start_backend() {
    echo -e "${BLUE}🚀 Starting MantraPath Backend Services...${NC}"
    
    cd "$PROJECT_ROOT/backend"
    
    # Create .env if it doesn't exist
    if [ ! -f .env ]; then
        cp "$PROJECT_ROOT/config/environment/.env.example" .env
        echo -e "${YELLOW}📝 Created .env file from template${NC}"
    fi
    
    # Start services with Docker Compose
    docker-compose up -d
    
    echo -e "${GREEN}✅ Backend services started${NC}"
    echo "🌐 API Gateway: http://localhost:8000"
    echo "📊 Service Status: docker-compose ps"
}

# Start frontend
start_frontend() {
    echo -e "${BLUE}🚀 Starting MantraPath Frontend...${NC}"
    
    cd "$PROJECT_ROOT/frontend"
    
    # Install dependencies if needed
    if [ ! -d "node_modules" ]; then
        echo -e "${YELLOW}📦 Installing frontend dependencies...${NC}"
        npm install
    fi
    
    # Start development server
    npm run dev &
    
    echo -e "${GREEN}✅ Frontend development server started${NC}"
    echo "🌐 Frontend: http://localhost:5173"
}

# Start full environment
start_full() {
    show_banner
    check_prerequisites
    
    echo -e "${BLUE}🚀 Starting Full MantraPath Development Environment${NC}"
    echo "=================================================="
    
    start_backend
    echo ""
    start_frontend
    
    echo ""
    echo -e "${GREEN}🎉 MantraPath is now running!${NC}"
    echo "================================"
    echo "🌐 Frontend: http://localhost:5173"
    echo "🔧 API Gateway: http://localhost:8000"
    echo "📊 Monitor: docker-compose logs -f"
    echo ""
    echo -e "${YELLOW}💡 Tip: Use './mantrapath logs' to view service logs${NC}"
}

# Stop all services
stop_services() {
    echo -e "${BLUE}🛑 Stopping MantraPath Services...${NC}"
    
    # Stop frontend
    pkill -f "vite\|npm.*dev" 2>/dev/null || true
    
    # Stop backend
    cd "$PROJECT_ROOT/backend"
    docker-compose down
    
    echo -e "${GREEN}✅ All services stopped${NC}"
}

# Show service status
show_status() {
    echo -e "${BLUE}📊 MantraPath Service Status${NC}"
    echo "============================"
    
    cd "$PROJECT_ROOT/backend"
    docker-compose ps
    
    # Check frontend
    if pgrep -f "vite\|npm.*dev" >/dev/null; then
        echo -e "${GREEN}✅ Frontend: Running${NC}"
    else
        echo -e "${RED}❌ Frontend: Stopped${NC}"
    fi
}

# View logs
view_logs() {
    echo -e "${BLUE}📋 Viewing MantraPath Logs...${NC}"
    cd "$PROJECT_ROOT/backend"
    docker-compose logs -f
}

# Clean up
cleanup() {
    echo -e "${BLUE}🧹 Cleaning up MantraPath environment...${NC}"
    
    cd "$PROJECT_ROOT/backend"
    docker-compose down -v
    docker system prune -f
    
    echo -e "${GREEN}✅ Cleanup complete${NC}"
}

# Initial setup
setup_project() {
    show_banner
    check_prerequisites
    
    echo -e "${BLUE}🔧 Setting up MantraPath project...${NC}"
    
    # Backend setup
    cd "$PROJECT_ROOT/backend"
    if [ ! -f .env ]; then
        cp "$PROJECT_ROOT/config/environment/.env.example" .env
        echo -e "${GREEN}✅ Backend .env created${NC}"
    fi
    
    # Frontend setup
    cd "$PROJECT_ROOT/frontend"
    if [ ! -d "node_modules" ]; then
        npm install
        echo -e "${GREEN}✅ Frontend dependencies installed${NC}"
    fi
    
    echo -e "${GREEN}🎉 Setup complete! Run './mantrapath start' to begin${NC}"
}

# Show help
show_help() {
    show_banner
    echo -e "${BLUE}Available Commands:${NC}"
    echo "  start      Start full development environment"
    echo "  backend    Start backend services only"
    echo "  frontend   Start frontend only"
    echo "  stop       Stop all services"
    echo "  status     Check service status"
    echo "  logs       View service logs"
    echo "  setup      Initial project setup"
    echo "  clean      Clean up containers and volumes"
    echo "  help       Show this help message"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  ./mantrapath start      # Start everything"
    echo "  ./mantrapath backend    # Backend only"
    echo "  ./mantrapath logs       # Monitor logs"
    echo ""
}

# Main command handling
case "${1:-help}" in
    "start" | "run")
        start_full
        ;;
    "backend" | "api")
        check_prerequisites
        start_backend
        ;;
    "frontend" | "ui")
        check_prerequisites
        start_frontend
        ;;
    "stop" | "down")
        stop_services
        ;;
    "status" | "ps")
        show_status
        ;;
    "logs" | "log")
        view_logs
        ;;
    "setup" | "init")
        setup_project
        ;;
    "clean" | "cleanup")
        cleanup
        ;;
    "help" | "-h" | "--help")
        show_help
        ;;
    *)
        echo -e "${RED}❌ Unknown command: $1${NC}"
        echo "Run './mantrapath help' for available commands"
        exit 1
        ;;
esac
