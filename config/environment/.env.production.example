# MantraPath Production Environment Configuration - EXAMPLE
# Copy this file to backend/.env and frontend/.env for production deployment
# Update values according to your production environment

# =============================================================================
# DOMAIN & HOST CONFIGURATION (PRODUCTION)
# =============================================================================
DOMAIN=mantrapath.com
PROTOCOL=https

# Port Configuration (Production typically uses standard ports)
FRONTEND_PORT=80
API_GATEWAY_PORT=443
AUTH_SERVICE_PORT=8001
PROFILE_SERVICE_PORT=8002
MOOD_SERVICE_PORT=8003
CHATBOT_SERVICE_PORT=8004
CONTENT_SERVICE_PORT=8005
COMMUNITY_SERVICE_PORT=8006
NOTIFICATION_SERVICE_PORT=8007
ML_SERVICE_PORT=8008
MEDIA_SERVICE_PORT=8021
TRANSLATION_SERVICE_PORT=8010

# Database Ports (Internal to Docker network)
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_AGENT_PORT=6380

# =============================================================================
# DATABASE CONFIGURATION (PRODUCTION)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_DB=mantrapath_production
POSTGRES_USER=mantrapath_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123!
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================================================
# REDIS CONFIGURATION (PRODUCTION)
# =============================================================================
REDIS_HOST=redis
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
REDIS_AGENT_URL=redis://${REDIS_HOST}:${REDIS_AGENT_PORT}

# =============================================================================
# APPLICATION URLS (PRODUCTION)
# =============================================================================
FRONTEND_URL=${PROTOCOL}://${DOMAIN}
API_GATEWAY_URL=${PROTOCOL}://api.${DOMAIN}
APP_URL=${FRONTEND_URL}

# =============================================================================
# SECURITY CONFIGURATION (PRODUCTION - CHANGE ALL)
# =============================================================================
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_KEY_IN_PRODUCTION
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_JWT_SECRET_KEY_IN_PRODUCTION
ALGORITHM=HS256

# Token Expiration (More secure for production)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# EMAIL CONFIGURATION (PRODUCTION)
# =============================================================================
SMTP_SERVER=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USERNAME=noreply@mantrapath.com
SMTP_PASSWORD=YOUR_SECURE_SMTP_PASSWORD
FROM_EMAIL=noreply@mantrapath.com

# =============================================================================
# AI SERVICES CONFIGURATION (PRODUCTION)
# =============================================================================
OPENAI_API_KEY=YOUR_PRODUCTION_OPENAI_API_KEY

# =============================================================================
# CORS CONFIGURATION (PRODUCTION)
# =============================================================================
CORS_ORIGINS=${FRONTEND_URL},${API_GATEWAY_URL}

# =============================================================================
# APPLICATION SETTINGS (PRODUCTION)
# =============================================================================
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=production

# Rate Limiting (More restrictive for production)
RATE_LIMIT_PER_MINUTE=30

# File Upload Limits
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp
