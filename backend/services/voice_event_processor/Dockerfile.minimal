FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY services/voice_event_processor/requirements.min.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY shared/ ./shared/
COPY services/voice_event_processor/ .

RUN mkdir -p /app/logs

ENV PYTHONPATH=/app
ENV VOICE_EVENT_PROCESSOR_PORT=8015
ENV LOG_LEVEL=INFO

EXPOSE 8015

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://voice-event-processor:8015/health || exit 1

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8015", "--reload"]
