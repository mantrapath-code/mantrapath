# syntax=docker/dockerfile:1.6
# Lightweight Dockerfile for CI/CD builds
FROM python:3.11-slim AS base

WORKDIR /app

# Get target architecture for conditional package installation
ARG TARGETARCH
ENV TARGETARCH=${TARGETARCH}

# Minimal system deps for basic audio I/O
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Essential audio deps only
    ffmpeg \
    libsndfile1 \
    # Build essentials
    gcc \
    g++ \
    make \
    pkg-config \
    git \
    # Utilities
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV PIP_DEFAULT_TIMEOUT=120 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Use light requirements for CI builds
COPY services/models_service/requirements-light.txt ./requirements.txt

# Install Python deps in optimized way
RUN python -m pip install --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt \
    && pip cache purge \
    && find /usr/local/lib/python3.11/site-packages -name "*.pyc" -delete \
    && find /usr/local/lib/python3.11/site-packages -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# Basic Whisper installation (CPU only for lighter build)
RUN pip install --no-cache-dir \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu \
    tiktoken \
    tqdm \
    && pip install --no-cache-dir --no-deps git+https://github.com/openai/whisper.git@main \
    && pip cache purge \
    && find /usr/local/lib/python3.11/site-packages -name "*.pyc" -delete \
    && find /usr/local/lib/python3.11/site-packages -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# Copy application code and shared
COPY services/models_service/ ./
COPY shared/ ./shared/

# Create test file for basic whisper validation
RUN echo "import whisper; print('Whisper loaded successfully')" > test_whisper_basic.py

# Test whisper installation (basic test)
RUN python test_whisper_basic.py || echo "⚠️ Whisper basic test failed, but continuing..."

# Final cleanup and prepare runtime
RUN chmod +x ./start_simple.sh || true \
    && mkdir -p models cache logs \
    && apt-get remove -y gcc g++ make pkg-config git \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /tmp/* \
    && rm -rf /root/.cache \
    && find /usr/local/lib/python3.11/site-packages -name "*.pyc" -delete \
    && find /usr/local/lib/python3.11/site-packages -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

ENV PYTHONPATH=/app \
    MODELS_DIR=/app/models \
    CACHE_DIR=/app/cache \
    LOGS_DIR=/app/logs \
    MODELS_SERVICE_MODE=minimal

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["./start_simple.sh"]