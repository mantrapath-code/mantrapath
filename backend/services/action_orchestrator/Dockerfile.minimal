FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY services/action_orchestrator/requirements.min.txt requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

COPY shared/ shared/
COPY services/action_orchestrator/src/ src/
COPY services/action_orchestrator/main.py main.py
COPY services/action_orchestrator/config.py config.py

RUN mkdir -p logs

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8012/health || exit 1

EXPOSE 8012

CMD ["python", "main.py"]
