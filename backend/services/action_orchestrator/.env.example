# Action Orchestrator Service Configuration

## Environment Variables

# Server Configuration
PORT=8012
HOST=0.0.0.0
RELOAD=false

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/mantrapath
REDIS_URL=redis://localhost:6379/0

# NATS Configuration
NATS_URL=nats://localhost:4222

# Service URLs
MOOD_SERVICE_URL=http://localhost:8001
JOURNAL_SERVICE_URL=http://localhost:8002
CHATBOT_SERVICE_URL=http://localhost:8003
PROFILE_SERVICE_URL=http://localhost:8004
COMMUNITY_SERVICE_URL=http://localhost:8005
ANALYTICS_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007

# Authentication
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Cultural Context
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,hi,ar,ja,ko,zh

# Orchestrator Configuration
MAX_WORKFLOW_STEPS=10
DEFAULT_TIMEOUT_SECONDS=30
MAX_RETRY_ATTEMPTS=3
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# Logging
LOG_LEVEL=INFO
