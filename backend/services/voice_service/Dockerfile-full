FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies for audio processing
RUN apt-get update && apt-get install -y \
    # Audio processing
    ffmpeg \
    sox \
    libsox-fmt-all \
    # Audio libraries
    libsndfile1-dev \
    portaudio19-dev \
    libportaudio2 \
    libasound2-dev \
    # General utilities
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Copy service-specific requirements first for better Docker layer caching
COPY services/voice_service/requirements-full.txt ./requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the application code (service-only)
COPY services/voice_service/ .
COPY shared/ ./shared/

# Create logs directory
RUN mkdir -p /app/logs

# Set environment variables
ENV PYTHONPATH=/app
ENV VOICE_SERVICE_PORT=8011
ENV LOG_LEVEL=INFO

# Expose the port
EXPOSE 8011

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8011/health || exit 1

# Run the application
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8011", "--reload"]
