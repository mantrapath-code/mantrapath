# Translation Service Environment Configuration

# Service Configuration
TRANSLATION_DEBUG=false
TRANSLATION_HOST=0.0.0.0
TRANSLATION_PORT=8010

# Database
DATABASE_URL=sqlite:///../../mantrapath.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/2

# JWT Configuration
JWT_SECRET_KEY=your-translation-service-secret-key-here
JWT_ALGORITHM=HS256

# Google Translate API
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key-here

# Microsoft Translator
MICROSOFT_TRANSLATOR_KEY=your-microsoft-translator-key-here
MICROSOFT_TRANSLATOR_REGION=global

# OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Performance Settings
TRANSLATION_MAX_CONCURRENT_TRANSLATIONS=100
TRANSLATION_TRANSLATION_TIMEOUT=30
TRANSLATION_RATE_LIMIT_PER_MINUTE=1000
TRANSLATION_MAX_TEXT_LENGTH=5000
TRANSLATION_BATCH_SIZE=50

# Quality Thresholds
TRANSLATION_MIN_CONFIDENCE_SCORE=0.7
TRANSLATION_TIER_1_QUALITY_THRESHOLD=0.95
TRANSLATION_TIER_2_QUALITY_THRESHOLD=0.90
TRANSLATION_TIER_3_QUALITY_THRESHOLD=0.85

# Cache Settings
TRANSLATION_CACHE_TTL_DEFAULT=3600
TRANSLATION_CACHE_TTL_PREMIUM=604800
TRANSLATION_CACHE_TTL_CRITICAL=2592000

# Voice Translation
TRANSLATION_VOICE_TRANSLATION_ENABLED=true
TRANSLATION_MAX_AUDIO_DURATION=300

# Offline Support
TRANSLATION_OFFLINE_MODE_ENABLED=true
TRANSLATION_OFFLINE_CACHE_SIZE_MB=1000

# Monitoring
TRANSLATION_PROMETHEUS_ENABLED=true
TRANSLATION_USAGE_ANALYTICS_ENABLED=true
TRANSLATION_DETAILED_LOGGING=false
