# API Gateway Configuration

# Environment
GATEWAY_ENVIRONMENT=development
GATEWAY_DEBUG=true
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# CORS
GATEWAY_CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
GATEWAY_CORS_CREDENTIALS=true

# Rate Limiting
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_REQUESTS_PER_MINUTE=100
GATEWAY_RATE_LIMIT_BURST=20

# Load Balancing
GATEWAY_LOAD_BALANCING_STRATEGY=round_robin

# Health Checks
GATEWAY_HEALTH_CHECK_INTERVAL=30
GATEWAY_HEALTH_CHECK_TIMEOUT=10
GATEWAY_HEALTH_CHECK_RETRIES=3

# Circuit Breaker
GATEWAY_CIRCUIT_BREAKER_ENABLED=true
GATEWAY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Redis
GATEWAY_REDIS_URL=redis://localhost:6379
GATEWAY_REDIS_TTL=300

# Security
GATEWAY_JWT_SECRET_KEY=your-secret-key-change-in-production
GATEWAY_JWT_ALGORITHM=HS256
GATEWAY_JWT_EXPIRATION=3600

# Logging
GATEWAY_LOG_LEVEL=INFO

# Monitoring
GATEWAY_METRICS_ENABLED=true
GATEWAY_METRICS_PORT=9090

# Services
SERVICE_AUTH_SERVICE_URL=http://localhost:8001
SERVICE_PROFILE_SERVICE_URL=http://localhost:8002
SERVICE_MOOD_SERVICE_URL=http://localhost:8003
SERVICE_CHATBOT_SERVICE_URL=http://localhost:8004
SERVICE_CONTENT_SERVICE_URL=http://localhost:8005
SERVICE_COMMUNITY_SERVICE_URL=http://localhost:8006
SERVICE_NOTIFICATION_SERVICE_URL=http://localhost:8007
SERVICE_ML_SERVICE_URL=http://localhost:8008
SERVICE_MEDIA_SERVICE_URL=http://localhost:8009
SERVICE_TRANSLATION_SERVICE_URL=http://localhost:8010
SERVICE_VOICE_SERVICE_URL=http://localhost:8011
