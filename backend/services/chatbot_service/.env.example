# MantraPath Chatbot Service Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://mantrapath:mantrapath123@postgres:5432/mantrapath

# Redis Configuration for Agent Cache
AGENT_REDIS_URL=redis://agent-redis:6379

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key-here
PHI4_MODEL_AVAILABLE=true

# Action Orchestrator Integration
ACTION_ORCHESTRATOR_URL=http://action-orchestrator:8012
ACTION_ORCHESTRATOR_ENABLED=true
ACTION_ORCHESTRATOR_TIMEOUT=60
ACTION_ORCHESTRATOR_MAX_RETRIES=3

# Enhanced Chatbot Configuration
ACTION_ORCHESTRATOR_INTEGRATION=true
CHATBOT_FALLBACK_TO_BASE=true

# Intent Processing Thresholds
MOOD_INTENT_THRESHOLD=0.7
TRANSLATION_INTENT_THRESHOLD=0.6
CROSS_SERVICE_THRESHOLD=0.8

# Service URLs for Integration
AUTH_SERVICE_URL=http://auth-service:8001
PROFILE_SERVICE_URL=http://profile-service:8002
MOOD_SERVICE_URL=http://mood-service:8003
CONTENT_SERVICE_URL=http://content-service:8005
COMMUNITY_SERVICE_URL=http://community-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007
ML_SERVICE_URL=http://ml-service:8008
MEDIA_SERVICE_URL=http://media-service:8009
TRANSLATION_SERVICE_URL=http://translation-service:8010
VOICE_SERVICE_URL=http://voice-service:8011

# CORS Configuration
FRONTEND_URL=http://localhost:5173
API_GATEWAY_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Development Settings
DEBUG=false
ENVIRONMENT=development
