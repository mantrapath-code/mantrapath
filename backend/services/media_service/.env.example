# Media Service Environment Variables

# Service Configuration
MEDIA_SERVICE_PORT=8009
MEDIA_SERVICE_HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost/mantrapath

# Redis Configuration
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Storage Configuration
PRIMARY_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
LOCAL_URL_PREFIX=/static/uploads

# AWS S3 Configuration (Production)
AWS_S3_BUCKET=mantrapath-media-prod
AWS_REGION=us-east-1
AWS_ACCESS_KEY=your_access_key
AWS_SECRET_KEY=your_secret_key

# MinIO Configuration (Development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mantrapath-media-dev
MINIO_SECURE=false

# CDN Configuration
CDN_PROVIDER=cloudflare
CDN_BASE_URL=https://cdn.mantrapath.com
CLOUDFLARE_ZONE_ID=your_zone_id
CLOUDFLARE_API_TOKEN=your_api_token

# Security Configuration
UPLOAD_VIRUS_SCANNING=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
MAX_UPLOAD_SIZE=500MB
ALLOWED_DOMAINS=mantrapath.com,localhost

# Processing Configuration
IMAGE_QUALITY_DEFAULT=85
THUMBNAIL_SIZE=300x300
VIDEO_COMPRESSION_PRESET=medium
AUDIO_BITRATE_DEFAULT=128k

# Monitoring Configuration
SENTRY_DSN=your_sentry_dsn
METRICS_ENABLED=true
LOG_LEVEL=INFO

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
