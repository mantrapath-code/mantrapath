# Environment variables for MantraPath Backend

# Database Configuration
DATABASE_URL=postgresql://mantrapath_user:mantrapath_password@postgres:5432/mantrapath
REDIS_URL=redis://redis:6379/0
MONGODB_URL=mongodb://mantrapath_user:mantrapath_password@mongodb:27017/mantrapath

# InfluxDB for Time-Series Analytics
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=your_influxdb_token_change_in_production
INFLUXDB_ORG=mantrapath
INFLUXDB_BUCKET=mood_analytics

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# External API Keys
OPENAI_API_KEY=your_openai_api_key_here

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4,audio/mpeg

# Service URLs (for internal communication)
AUTH_SERVICE_URL=http://auth_service:8001
PROFILE_SERVICE_URL=http://profile_service:8002
MOOD_SERVICE_URL=http://mood_service:8003
CHATBOT_SERVICE_URL=http://chatbot_service:8004
CONTENT_SERVICE_URL=http://content_service:8005
COMMUNITY_SERVICE_URL=http://community_service:8006
NOTIFICATION_SERVICE_URL=http://notification_service:8007
MEDIA_SERVICE_URL=http://media_service:8009
ANALYTICS_SERVICE_URL=http://analytics_service:8010

# Security Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Production Settings (set to true in production)
PRODUCTION=false
DEBUG=true
TESTING=false