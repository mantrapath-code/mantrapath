# MantraPath Backend Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://mantrapath:mantrapath123@localhost:5432/mantrapath

# Redis Configuration  
REDIS_URL=redis://localhost:6379

# Security
SECRET_KEY=your-super-secret-key-change-in-production-use-64-chars-minimum
ALGORITHM=HS256

# Token Expiration (in minutes/days)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Service URLs (for development)
AUTH_SERVICE_URL=http://localhost:8001
PROFILE_SERVICE_URL=http://localhost:8002  
MOOD_SERVICE_URL=http://localhost:8003
CHATBOT_SERVICE_URL=http://localhost:8004
CONTENT_SERVICE_URL=http://localhost:8005
COMMUNITY_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007
MEDIA_SERVICE_URL=http://localhost:8009

# AI Services (Optional - for enhanced chatbot features)
OPENAI_API_KEY=your-openai-api-key-here

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Production Settings
DEBUG=false
ENVIRONMENT=development