# MantraPath Backend Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration  
DATABASE_URL=postgresql://mantrapath:mantrapath123@postgres:5432/mantrapath

# Redis Configuration  
REDIS_URL=redis://redis:6379

# Security
SECRET_KEY=your-super-secret-key-change-in-production-use-64-chars-minimum
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
ALGORITHM=HS256

# Token Expiration (in minutes/days)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Configuration (Required for email verification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=SMTP
SMTP_PASSWORD=your-app-password  # Use Gmail App Password, not regular password
FROM_EMAIL=your-email@gmail.com

# Application URL (for email verification links)
APP_URL=http://localhost:5173

# Alternative SMTP Providers:
# For Outlook/Hotmail: smtp-mail.outlook.com:587
# For Yahoo: smtp.mail.yahoo.com:587
# For SendGrid: smtp.sendgrid.net:587
# For Mailgun: smtp.mailgun.org:587

# AI Services (Optional - for enhanced chatbot features)
OPENAI_API_KEY=your-openai-api-key-here

# Email Verification (Development)
SKIP_EMAIL_VERIFICATION=true  # Set to true to bypass email verification for local development

# CORS Settings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Production Settings
DEBUG=false
ENVIRONMENT=development