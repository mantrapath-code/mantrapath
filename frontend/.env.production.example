# MantraPath Frontend Production Environment Variables
# Copy to frontend/.env.production and adjust DOMAIN.

VITE_DOMAIN=your-domain.com
VITE_PROTOCOL=https
VITE_API_BASE_URL=${VITE_PROTOCOL}://${VITE_DOMAIN}/api
VITE_API_GATEWAY_URL=${VITE_API_BASE_URL}
VITE_API_URL=${VITE_API_BASE_URL}
VITE_WS_URL=wss://${VITE_DOMAIN}

# Optional direct service URLs (prefer going through gateway where possible)
# VITE_ML_SERVICE_URL=${VITE_PROTOCOL}://${VITE_DOMAIN}/api/ml

# Tuning
VITE_BUILD_ENV=production
