# MantraPath Frontend Environment Configuration
# This file contains environment variables for the frontend development

# Frontend server configuration
VITE_FRONTEND_PORT=5173

# API Gateway configuration
VITE_API_GATEWAY_URL=http://localhost:8000

# Development flags
VITE_NODE_ENV=development
VITE_DEBUG=true

# For ngrok/external access, these will be dynamically set
# VITE_NGROK_API_URL=
# VITE_NGROK_FRONTEND_URL=
